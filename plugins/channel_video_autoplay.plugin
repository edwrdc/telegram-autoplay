from android.net import Uri
from android_utils import run_on_ui_thread
from base_plugin import BasePlugin, MethodHook
from client_utils import send_request
from hook_utils import get_private_field, set_private_field
from java.lang import Boolean, Integer
from org.telegram.messenger import (
    FileLoader, MediaController, MediaDataController, MessageObject,
    MessagesController, UserConfig,
)
from org.telegram.tgnet import ConnectionsManager, TLRPC
from org.telegram.ui import PhotoViewer
from ui.settings import Switch

__id__ = "channel_video_autoplay"
__name__ = "Channel video autoplay"
__description__ = "Experimental continuous channel video playback, oldest to newest."
__author__ = "https://github.com/edwrdc"
__version__ = "0.1.1"
__sdk_version__ = ">=1.4.5.3"
__category__ = ["chats", "tools"]


class PlaybackHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if not param.hasThrowable() and param.args[1] == 4:
            try:
                self.plugin._ended(param.thisObject)
            except Exception:
                self.plugin._fail()


class PreparedHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if not param.hasThrowable():
            try:
                self.plugin._update_loop(param.thisObject)
            except Exception:
                self.plugin._fail()


class LeaveHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        self.plugin._cancel()


class ChannelVideoAutoplayPlugin(BasePlugin):
    def on_plugin_load(self):
        self._alive = False
        self._enabled = self.get_setting("enabled", True)
        self._pending = None
        self._request = None
        self._loop = None
        self._unhooks = []
        self._viewer_class = PhotoViewer.getClass()
        try:
            # shortcut: private viewer APIs, recheck against source when AyuGram changes them.
            for name in (
                "currentMessageObject", "currentAccount", "currentDialogId",
                "classGuid", "videoPlayer", "inPreview", "currentEditMode",
                "isInline", "switchingInlineMode", "imagesArr", "imagesByIds",
                "currentIndex", "opennedFromMedia", "sharedMediaType",
            ):
                self._viewer_class.getDeclaredField(name)
            self._index = self._method("setImageIndex", Integer.TYPE)
            self._images = self._method("setImages")
            self._action = self._method("onActionClick", Boolean.TYPE)
            state = self._method("updatePlayerState", Boolean.TYPE, Integer.TYPE)
            prepare = self._method(
                "preparePlayer", Uri.getClass(), Boolean.TYPE,
                Boolean.TYPE,
                MediaController.SavedFilterState.getClass(),
            )
            for method, handler in (
                (state, PlaybackHook(self)), (prepare, PreparedHook(self)),
                (self._method("onResume"), PreparedHook(self)),
            ):
                unhook = self.hook_method(method, handler)
                if not unhook:
                    raise RuntimeError("Could not install viewer hook")
                self._unhooks.append(unhook)
            leave = self.hook_all_methods(self._viewer_class, "closePhoto", LeaveHook(self))
            if not leave:
                raise RuntimeError("Could not hook viewer close")
            self._unhooks.extend(leave)
            self._alive = True
            run_on_ui_thread(self._refresh)
            self.logger.info(f"Channel autoplay {__version__} loaded")
        except Exception:
            self.logger.exception("Unsupported viewer or SDK; autoplay not loaded")
            self.on_plugin_unload()
            raise

    def _method(self, name, *types):
        method = self._viewer_class.getDeclaredMethod(name, *types)
        method.setAccessible(True)
        return method

    def create_settings(self):
        return [Switch(
            key="enabled", text="Continuous channel videos", default=True,
            subtext="Play the next newer video. Uses your normal Telegram data and cache.",
            on_change=self._toggle,
        )]

    def _toggle(self, enabled):
        self._enabled = enabled
        run_on_ui_thread(self._refresh)

    def _refresh(self):
        try:
            self._cancel()
            self._restore_loop()
            if self._alive and PhotoViewer.hasInstance():
                self._update_loop(PhotoViewer.getInstance())
        except Exception:
            self._fail()

    def _eligible(self, viewer):
        if not self._alive or not self._enabled or not viewer.isVisible():
            return False
        if (get_private_field(viewer, "inPreview")
                or get_private_field(viewer, "currentEditMode") != 0
                or get_private_field(viewer, "isInline")
                or get_private_field(viewer, "switchingInlineMode")):
            return False
        message = get_private_field(viewer, "currentMessageObject")
        if (message is None or message.scheduled or message.getId() <= 0
                or not message.isVideo()
                or not isinstance(message.messageOwner.media, TLRPC.TL_messageMediaDocument)):
            return False
        account = get_private_field(viewer, "currentAccount")
        dialog = message.getDialogId()
        if (account != message.currentAccount or account != UserConfig.selectedAccount
                or dialog >= 0 or dialog != get_private_field(viewer, "currentDialogId")):
            return False
        chat = MessagesController.getInstance(account).getChat(-dialog)
        return chat is not None and chat.broadcast and not chat.megagroup

    def _update_loop(self, viewer):
        player = get_private_field(viewer, "videoPlayer")
        if not self._eligible(viewer) or player is None:
            return
        if self._loop is None or self._loop[0] != player:
            self._restore_loop()
            self._loop = (player, player.isLooping())
        player.setLooping(False)

    def _restore_loop(self):
        if self._loop is not None:
            player, looping = self._loop
            self._loop = None
            player.setLooping(looping)

    def _ended(self, viewer):
        if not self._eligible(viewer) or self._pending is not None:
            return
        player = get_private_field(viewer, "videoPlayer")
        if player is None:
            return
        message = get_private_field(viewer, "currentMessageObject")
        pending = {
            "viewer": viewer, "player": player,
            "account": message.currentAccount, "dialog": message.getDialogId(),
            "id": message.getId(), "guid": get_private_field(viewer, "classGuid"),
        }
        self._pending = pending
        # A positive delay lets the native end handler finish rewinding and pausing.
        run_on_ui_thread(lambda: self._fetch(pending, pending["id"]), 1)

    def _valid(self, pending):
        if self._pending is not pending:
            return False
        viewer = pending["viewer"]
        message = get_private_field(viewer, "currentMessageObject")
        return (self._eligible(viewer)
                and get_private_field(viewer, "classGuid") == pending["guid"]
                and get_private_field(viewer, "videoPlayer") == pending["player"]
                and message.currentAccount == pending["account"]
                and message.getDialogId() == pending["dialog"]
                and message.getId() == pending["id"]
                and not pending["player"].isPlaying())

    def _fetch(self, pending, cursor):
        try:
            if not self._valid(pending):
                if self._pending is pending:
                    self._cancel()
                return
            request = TLRPC.TL_messages_getHistory()
            request.peer = MessagesController.getInstance(pending["account"]).getInputPeer(
                pending["dialog"]
            )
            request.offset_id = cursor + 1
            request.add_offset = -100
            request.limit = 100
            request.min_id = 0
            request.max_id = 0
            request.offset_date = 0
            request.hash = 0

            def received(response, error):
                run_on_ui_thread(lambda: self._receive(pending, cursor, response, error))

            request_id = send_request(request, received, account=pending["account"])
            self._request = (pending["account"], request_id)
            run_on_ui_thread(lambda: self._timeout(pending, request_id), 20000)
        except Exception:
            self._fail()

    def _receive(self, pending, cursor, response, error):
        try:
            if self._pending is not pending:
                return
            self._request = None
            if not self._valid(pending):
                self._cancel()
                return
            if error is not None:
                self.logger.warning(f"Autoplay history failed: {error.text}")
                self._cancel()
                return
            if response is None:
                raise RuntimeError("Empty history response")
            rows = sorted(
                (row for row in response.messages
                 if row.id > cursor and row.peer_id is not None
                 and row.peer_id.channel_id == -pending["dialog"]),
                key=lambda row: row.id,
            )
            for row in rows:
                if (isinstance(row.media, TLRPC.TL_messageMediaDocument)
                        and MessageObject.isVideoMessage(row)):
                    message = MessageObject(pending["account"], row, False, True)
                    self._show(pending, message)
                    return
            if not rows:
                self.logger.info("Autoplay reached the end of the channel")
                self._cancel()
                return
            run_on_ui_thread(lambda: self._fetch(pending, rows[-1].id), 350)
        except Exception:
            self._fail()

    def _show(self, pending, message):
        viewer = pending["viewer"]
        images = get_private_field(viewer, "imagesArr")
        index = next((i for i in range(images.size())
                      if images.get(i).getDialogId() == pending["dialog"]
                      and images.get(i).getId() == message.getId()), None)
        if index is None:
            descending = get_private_field(viewer, "opennedFromMedia")
            channel_indices = [i for i in range(images.size())
                               if images.get(i).getDialogId() == pending["dialog"]]
            index = next((i for i in channel_indices
                          if (images.get(i).getId() < message.getId() if descending
                              else images.get(i).getId() > message.getId())),
                         channel_indices[-1] + 1)
            current = get_private_field(viewer, "currentIndex")
            # shortcut: sparse inserts can skew gallery counters, use native paging if exact counts are needed.
            images.add(index, message)
            get_private_field(viewer, "imagesByIds")[0].put(message.getId(), message)
            if index <= current:
                self._set(viewer, "currentIndex", current + 1)
        else:
            message = images.get(index)
        self._cancel()
        message.forceSeekTo = 0.0
        # File galleries otherwise send videos to an external document viewer.
        self._set(viewer, "sharedMediaType", MediaDataController.MEDIA_PHOTOVIDEO)
        self._index.invoke(viewer, Integer(index))
        if get_private_field(viewer, "currentMessageObject").getId() != message.getId():
            raise RuntimeError("Viewer did not select the next video")
        self._images.invoke(viewer)
        self._action.invoke(viewer, Boolean(False))
        if get_private_field(viewer, "videoPlayer") is None:
            FileLoader.getInstance(pending["account"]).loadFile(
                message.getDocument(), message, FileLoader.PRIORITY_NORMAL, 0,
            )
        self.logger.info("Autoplay selected the next channel video")

    def _set(self, viewer, name, value):
        if not set_private_field(viewer, name, value):
            raise RuntimeError(f"Cannot set PhotoViewer.{name}")

    def _timeout(self, pending, request_id):
        if (self._pending is pending
                and self._request == (pending["account"], request_id)):
            self.logger.warning("Autoplay history timed out; stopped")
            self._cancel()

    def _cancel(self):
        self._pending = None
        request, self._request = self._request, None
        if request is not None:
            try:
                ConnectionsManager.getInstance(request[0]).cancelRequest(request[1], True)
            except Exception:
                self.logger.exception("Could not cancel autoplay history request")

    def _fail(self):
        self.logger.exception("Autoplay stopped after an error; reload the plugin to retry")
        self._alive = False
        self._cancel()
        try:
            self._restore_loop()
        except Exception:
            self.logger.exception("Could not restore video looping")

    def on_plugin_unload(self):
        self._alive = False
        self._cancel()
        for unhook in self._unhooks:
            try:
                unhook.unhook()
            except Exception:
                self.logger.exception("Could not remove a viewer hook")
        self._unhooks.clear()
        run_on_ui_thread(self._restore_loop)
